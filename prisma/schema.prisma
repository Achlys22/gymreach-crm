// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model GymLead {
  id          String    @id @default(cuid())
  name        String
  instagram   String    @unique
  city        String?
  region      String?
  disciplines String    // comma-separated: MMA,Muay Thai,Boxing
  status      String    @default("new") // new, contacted, replied, interested, won, lost
  priority    String    @default("medium") // low, medium, high
  notes       String?
  detail      String?   // manually-researched specific detail for Line 1
  message     String?   // generated personalized cold DM
  followUpAt  DateTime?
  contactedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([region])
}

model RestaurantLead {
  id               String    @id @default(cuid())
  name             String
  instagram        String?
  phone            String?
  city             String?
  region           String?
  cuisine          String?   // Italian, Indian, Fine Dining, Pub, etc.
  hasWebsite       Boolean   @default(false)
  reservationSystem String?  // OpenTable, Resy, TheFork, SevenRooms, None
  botDeployed      Boolean   @default(false)
  status           String    @default("new") // new, contacted, demo_sent, interested, won, lost
  priority         String    @default("medium")
  notes            String?
  detail           String?   // manually-researched specific detail for Line 1
  message          String?   // generated pitch for reservation bot
  followUpAt       DateTime?
  contactedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([region])
}
